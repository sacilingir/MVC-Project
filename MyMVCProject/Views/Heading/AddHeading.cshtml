@model EntityLayer.Concrete.Heading
@{
    ViewData["Title"] = "AddHeading";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Başlık ekleme sayfası</h1>
<br />

@using (Html.BeginForm("AddHeading", "Heading", FormMethod.Post))
{
    <div class="form-group">
        @Html.Label("Başlık Adı")
        @Html.TextBoxFor(x => x.HeadingName, new { @class = "form-control"})
        <div style="color:red">
            @Html.ValidationMessageFor(x => x.HeadingName)
        </div>
        <br />
        @Html.Label("Kategori")
        @Html.DropDownListFor(x => x.CategoryID,(List<SelectListItem>)ViewBag.vlc,new { @class = "form-control"})
        <div style="color:red">
            @Html.ValidationMessageFor(x => x.CategoryID)
        </div>
        <br />
        @Html.Label("Yazar")
        @Html.DropDownListFor(x => x.WriterID, (List <SelectListItem>)ViewBag.vwc,new { @class = "form-control"})
        <div style="color:red">
            @Html.ValidationMessageFor(x => x.WriterID)
        </div>
        <br />
        <button class="btn btn-info">Başlığı oluştur</button>
        
    </div>
}



